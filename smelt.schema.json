{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mathisarends/smelt/main/smelt.schema.json",
  "$defs": {
    "ArchitectureConfig": {
      "additionalProperties": false,
      "properties": {
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeaturesConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shared": {
          "items": {
            "type": "string"
          },
          "title": "Shared",
          "type": "array"
        },
        "composition_root": {
          "items": {
            "type": "string"
          },
          "title": "Composition Root",
          "type": "array"
        },
        "wiring": {
          "items": {
            "type": "string"
          },
          "title": "Wiring",
          "type": "array"
        },
        "modules": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Modules",
          "type": "object"
        },
        "layers": {
          "additionalProperties": {
            "$ref": "#/$defs/LayerConfig"
          },
          "title": "Layers",
          "type": "object"
        },
        "cross_feature": {
          "$ref": "#/$defs/CrossFeatureConfig"
        },
        "imports": {
          "$ref": "#/$defs/ImportsConfig"
        }
      },
      "title": "ArchitectureConfig",
      "type": "object"
    },
    "CrossFeatureAllowance": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "CrossFeatureAllowance",
      "type": "object"
    },
    "CrossFeatureConfig": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/Policy",
          "default": "deny"
        },
        "allow": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/CrossFeatureAllowance"
              }
            ]
          },
          "title": "Allow",
          "type": "array"
        }
      },
      "title": "CrossFeatureConfig",
      "type": "object"
    },
    "CycleScope": {
      "enum": [
        "features",
        "layers",
        "siblings"
      ],
      "type": "string"
    },
    "FeaturesConfig": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Root"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        }
      },
      "title": "FeaturesConfig",
      "type": "object"
    },
    "IgnoreEntry": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "reason"
      ],
      "title": "IgnoreEntry",
      "type": "object"
    },
    "ImportsConfig": {
      "additionalProperties": false,
      "properties": {
        "type_checking": {
          "default": "include",
          "enum": [
            "include",
            "ignore"
          ],
          "title": "Type Checking",
          "type": "string"
        },
        "transitive": {
          "default": false,
          "title": "Transitive",
          "type": "boolean"
        },
        "cycles": {
          "items": {
            "$ref": "#/$defs/CycleScope"
          },
          "title": "Cycles",
          "type": "array"
        }
      },
      "title": "ImportsConfig",
      "type": "object"
    },
    "LayerConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "may_depend_on": {
          "items": {
            "type": "string"
          },
          "title": "May Depend On",
          "type": "array"
        },
        "third_party": {
          "$ref": "#/$defs/ThirdPartyPolicy"
        }
      },
      "required": [
        "path"
      ],
      "title": "LayerConfig",
      "type": "object"
    },
    "Policy": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "root_packages": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Root Packages",
          "type": "array"
        },
        "source_roots": {
          "items": {
            "type": "string"
          },
          "title": "Source Roots",
          "type": "array"
        },
        "test_roots": {
          "items": {
            "type": "string"
          },
          "title": "Test Roots",
          "type": "array"
        },
        "exclude": {
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "required": [
        "root_packages"
      ],
      "title": "ProjectConfig",
      "type": "object"
    },
    "SeverityName": {
      "enum": [
        "error",
        "warning",
        "hint",
        "off"
      ],
      "type": "string"
    },
    "StructureConfig": {
      "additionalProperties": false,
      "properties": {
        "forbidden_names": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Names",
          "type": "array"
        }
      },
      "title": "StructureConfig",
      "type": "object"
    },
    "SuppressionsConfig": {
      "additionalProperties": false,
      "properties": {
        "require_reason": {
          "default": true,
          "title": "Require Reason",
          "type": "boolean"
        }
      },
      "title": "SuppressionsConfig",
      "type": "object"
    },
    "TestsConfig": {
      "additionalProperties": false,
      "properties": {
        "layout": {
          "default": "none",
          "enum": [
            "mirror",
            "none"
          ],
          "title": "Layout",
          "type": "string"
        },
        "mirror": {
          "default": "{path}/test_{module}.py",
          "title": "Mirror",
          "type": "string"
        },
        "unmirrored": {
          "items": {
            "type": "string"
          },
          "title": "Unmirrored",
          "type": "array"
        },
        "mirror_suffixes": {
          "default": false,
          "title": "Mirror Suffixes",
          "type": "boolean"
        }
      },
      "title": "TestsConfig",
      "type": "object"
    },
    "ThirdPartyPolicy": {
      "anyOf": [
        {
          "enum": [
            "allow",
            "deny"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "default": {
              "$ref": "#/$defs/Policy",
              "default": "allow"
            },
            "allow": {
              "items": {
                "type": "string"
              },
              "title": "Allow",
              "type": "array"
            },
            "deny": {
              "items": {
                "type": "string"
              },
              "title": "Deny",
              "type": "array"
            }
          },
          "title": "ThirdPartyPolicy",
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "architecture": {
      "$ref": "#/$defs/ArchitectureConfig"
    },
    "structure": {
      "$ref": "#/$defs/StructureConfig"
    },
    "tests": {
      "$ref": "#/$defs/TestsConfig"
    },
    "rules": {
      "additionalProperties": {
        "$ref": "#/$defs/SeverityName"
      },
      "title": "Rules",
      "type": "object"
    },
    "ignore": {
      "items": {
        "$ref": "#/$defs/IgnoreEntry"
      },
      "title": "Ignore",
      "type": "array"
    },
    "suppressions": {
      "$ref": "#/$defs/SuppressionsConfig"
    },
    "debt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Debt"
    }
  },
  "required": [
    "version",
    "project"
  ],
  "title": "smelt.yaml",
  "type": "object"
}
