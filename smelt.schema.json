{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mathisarends/smelt/main/smelt.schema.json",
  "$defs": {
    "ArchitectureConfig": {
      "additionalProperties": false,
      "description": "Features, layers and the modules around them.",
      "properties": {
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeaturesConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the features (vertical slices) live."
        },
        "shared": {
          "description": "Modules every feature may import; they must not import features.",
          "items": {
            "type": "string"
          },
          "title": "Shared",
          "type": "array"
        },
        "composition_root": {
          "description": "Modules that wire everything; nothing may import them.",
          "items": {
            "type": "string"
          },
          "title": "Composition Root",
          "type": "array"
        },
        "wiring": {
          "description": "Provider modules (whole-segment * allowed) that may import across layers and features; they keep their feature and layer.",
          "items": {
            "type": "string"
          },
          "title": "Wiring",
          "type": "array"
        },
        "modules": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Packages outside the features mapped to a layer, e.g. {backend.platform: infrastructure}.",
          "title": "Modules",
          "type": "object"
        },
        "layers": {
          "additionalProperties": {
            "$ref": "#/$defs/LayerConfig"
          },
          "description": "The layers and what each may import.",
          "title": "Layers",
          "type": "object"
        },
        "cross_feature": {
          "$ref": "#/$defs/CrossFeatureConfig"
        },
        "imports": {
          "$ref": "#/$defs/ImportsConfig",
          "description": "Which imports count."
        }
      },
      "title": "ArchitectureConfig",
      "type": "object"
    },
    "CrossFeatureAllowance": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "title": "From",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "title": "CrossFeatureAllowance",
      "type": "object"
    },
    "CrossFeatureConfig": {
      "additionalProperties": false,
      "description": "Imports between features.",
      "properties": {
        "default": {
          "$ref": "#/$defs/Policy",
          "default": "deny",
          "description": "Whether features may import each other at all."
        },
        "allow": {
          "description": "Allowed imports: \"layer -> layer\" for all features, or {from: feature.layer, to: feature.layer}.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/CrossFeatureAllowance"
              }
            ]
          },
          "title": "Allow",
          "type": "array"
        }
      },
      "title": "CrossFeatureConfig",
      "type": "object"
    },
    "CycleScope": {
      "enum": [
        "features",
        "layers",
        "siblings"
      ],
      "type": "string"
    },
    "FeaturesConfig": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Package whose direct child packages are the features.",
          "title": "Root"
        },
        "pattern": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Dotted pattern ending in {feature}, e.g. \"app.{feature}\".",
          "title": "Pattern"
        }
      },
      "title": "FeaturesConfig",
      "type": "object"
    },
    "IgnoreEntry": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "modules": {
          "items": {
            "type": "string"
          },
          "title": "Modules",
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "title": "Paths",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "reason"
      ],
      "title": "IgnoreEntry",
      "type": "object"
    },
    "ImportsConfig": {
      "additionalProperties": false,
      "description": "Which imports the dependency rules look at.",
      "properties": {
        "type_checking": {
          "default": "include",
          "description": "Whether imports under `if TYPE_CHECKING:` count.",
          "enum": [
            "include",
            "ignore"
          ],
          "title": "Type Checking",
          "type": "string"
        },
        "transitive": {
          "default": false,
          "description": "Also report layer violations through other modules.",
          "title": "Transitive",
          "type": "boolean"
        },
        "cycles": {
          "description": "Where SMT104 looks for cycles.",
          "items": {
            "$ref": "#/$defs/CycleScope"
          },
          "title": "Cycles",
          "type": "array"
        }
      },
      "title": "ImportsConfig",
      "type": "object"
    },
    "LayerConfig": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Dotted path of the layer package inside a feature.",
          "title": "Path",
          "type": "string"
        },
        "may_depend_on": {
          "description": "Layers this layer may import.",
          "items": {
            "type": "string"
          },
          "title": "May Depend On",
          "type": "array"
        },
        "third_party": {
          "$ref": "#/$defs/ThirdPartyPolicy",
          "description": "Which third-party packages the layer may import (SMT103)."
        }
      },
      "required": [
        "path"
      ],
      "title": "LayerConfig",
      "type": "object"
    },
    "Policy": {
      "enum": [
        "allow",
        "deny"
      ],
      "type": "string"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "description": "Which packages and tests smelt reads.",
      "properties": {
        "root_packages": {
          "description": "Top-level packages to check; discovered from source_roots when omitted.",
          "items": {
            "type": "string"
          },
          "title": "Root Packages",
          "type": "array"
        },
        "source_roots": {
          "description": "Directories that contain the root packages, e.g. [src].",
          "items": {
            "type": "string"
          },
          "title": "Source Roots",
          "type": "array"
        },
        "test_roots": {
          "description": "Directories with the tests; with layout: mirror they must exist.",
          "items": {
            "type": "string"
          },
          "title": "Test Roots",
          "type": "array"
        },
        "exclude": {
          "description": "Path globs smelt skips entirely.",
          "items": {
            "type": "string"
          },
          "title": "Exclude",
          "type": "array"
        }
      },
      "title": "ProjectConfig",
      "type": "object"
    },
    "SeverityName": {
      "enum": [
        "error",
        "warning",
        "hint",
        "off"
      ],
      "type": "string"
    },
    "StructureConfig": {
      "additionalProperties": false,
      "description": "Naming rules for packages and modules.",
      "properties": {
        "forbidden_names": {
          "description": "Package and module names to avoid (SMT302).",
          "items": {
            "type": "string"
          },
          "title": "Forbidden Names",
          "type": "array"
        }
      },
      "title": "StructureConfig",
      "type": "object"
    },
    "SuppressionsConfig": {
      "additionalProperties": false,
      "description": "Inline `# smelt: ignore[CODE] -- reason` comments.",
      "properties": {
        "require_reason": {
          "default": true,
          "title": "Require Reason",
          "type": "boolean"
        }
      },
      "title": "SuppressionsConfig",
      "type": "object"
    },
    "TestsConfig": {
      "additionalProperties": false,
      "description": "Where test files must live.",
      "properties": {
        "layout": {
          "default": "none",
          "description": "mirror: every test file must mirror a source module.",
          "enum": [
            "mirror",
            "none"
          ],
          "title": "Layout",
          "type": "string"
        },
        "mirror": {
          "default": "{path}/test_{module}.py",
          "description": "Test path relative to the test root; placeholders {root}, {path}, {module}.",
          "title": "Mirror",
          "type": "string"
        },
        "unmirrored": {
          "description": "Test path globs exempt from mirroring, e.g. [\"tests/e2e/**\"].",
          "items": {
            "type": "string"
          },
          "title": "Unmirrored",
          "type": "array"
        },
        "mirror_suffixes": {
          "default": false,
          "description": "Also allow test_<module>_<topic>.py.",
          "title": "Mirror Suffixes",
          "type": "boolean"
        }
      },
      "title": "TestsConfig",
      "type": "object"
    },
    "ThirdPartyPolicy": {
      "anyOf": [
        {
          "enum": [
            "allow",
            "deny"
          ],
          "type": "string"
        },
        {
          "additionalProperties": false,
          "properties": {
            "default": {
              "$ref": "#/$defs/Policy",
              "default": "allow"
            },
            "allow": {
              "items": {
                "type": "string"
              },
              "title": "Allow",
              "type": "array"
            },
            "deny": {
              "items": {
                "type": "string"
              },
              "title": "Deny",
              "type": "array"
            }
          },
          "title": "ThirdPartyPolicy",
          "type": "object"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "architecture": {
      "$ref": "#/$defs/ArchitectureConfig"
    },
    "structure": {
      "$ref": "#/$defs/StructureConfig"
    },
    "tests": {
      "$ref": "#/$defs/TestsConfig"
    },
    "rules": {
      "additionalProperties": {
        "$ref": "#/$defs/SeverityName"
      },
      "description": "Severity per rule code, or off.",
      "title": "Rules",
      "type": "object"
    },
    "ignore": {
      "description": "Rules to skip for modules or paths.",
      "items": {
        "$ref": "#/$defs/IgnoreEntry"
      },
      "title": "Ignore",
      "type": "array"
    },
    "suppressions": {
      "$ref": "#/$defs/SuppressionsConfig",
      "description": "Inline `# smelt: ignore` rules."
    },
    "debt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Debt file with known violations, e.g. .smelt/debt.json.",
      "title": "Debt"
    }
  },
  "required": [
    "version",
    "project"
  ],
  "title": "smelt.yaml",
  "type": "object"
}
